# Copy to .env (never commit it) and pass it to the scripts with --env-file .env, or export AI_VIDEO_ENV=/path/.env.
# Scripts read these from the environment first, then from that file. Values are never printed.

# Gemini API: Omni 1.2 video takes (omni.py, omni_chain.py) and Nano Banana stills (gemini_image.py).
# Google AI Studio key on a project with billing; watch the project's monthly spend cap (HTTP 429).
GEMINI_API_KEY=
# GOOGLE_API_KEY=            # accepted instead of GEMINI_API_KEY

# ElevenLabs: word-timed speech-to-text (stt.py, align_cut.py) and voice-overs. Needs speech-to-text access.
ELEVENLABS_API_KEY=

# Optional: Higgsfield / Seedance (higgsfield-api skill)
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=

# Optional: only if your PinchTab server requires auth (Google Flow route through the google-flow skill)
# PINCHTAB_TOKEN=
