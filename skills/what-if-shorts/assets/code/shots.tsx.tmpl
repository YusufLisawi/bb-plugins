/**
 * {{TITLE}} — the shots. Generated as placeholder cards (an animatic: type · length · id · what · devices) so the film
 * plays, timed to the voice, from minute one. Replace each placeholder with the real shot, following the pattern of
 * src/episodes/farm/shotsA.tsx: Plane layers (far 0.5–0.6 · mid 0.8–0.9 · action 1 · near 1.1–1.3 with blur 10–16),
 * pushCam on every shot, characters from src/kit/flat, HUD in screen space. Split into shotsB.tsx … past ≈ 10 shots.
 */
import React from "react";
import { AbsoluteFill } from "remotion";
import { clamp, E } from "../../core/anim";
import { FF } from "../../kit/flat/fonts";
import { camLerp, type Cam } from "../../kit/flat/look";
import type { ShotProps } from "./{{COMP}}";

/** a sine-eased camera move over the shot (use one on EVERY shot: a 2–7 % push, a drift, a zoom) */
export const pushCam = (t: number, t0: number, t1: number, a: Cam, b: Cam): Cam => camLerp(a, b, E.sineInOut(clamp((t - t0) / (t1 - t0))));

const TYPE_BG: Record<string, string> = {
  acting: "#cdbf9f", closeup: "#d9c6a8", ots: "#5d5348", insert: "#bcae92", map: "#9fb07a", diagram: "#cbb993", card: "#e8dfcf",
  slam: "#2a2422", threat: "#1f2328", inventory: "#a9bd84", journey: "#28324a", end: "#141212",
};

const Placeholder: React.FC<ShotProps & { id: string; type: string; what: string; devices: string }> = ({ t, t0, t1, id, type, what, devices }) => {
  const p = clamp((t - t0) / Math.max(0.01, t1 - t0));
  const dark = ["ots", "slam", "threat", "journey", "end"].includes(type);
  return (
    <AbsoluteFill style={{ background: TYPE_BG[type] ?? "#999", color: dark ? "#f3efe6" : "#24211d", fontFamily: FF.cond, transform: `scale(${(1 + 0.04 * p).toFixed(4)})` }}>
      <div style={{ position: "absolute", left: 80, right: 80, top: 250, fontSize: 44, fontWeight: 700, letterSpacing: "0.08em", opacity: 0.7 }}>
        {type.toUpperCase()} · {(t1 - t0).toFixed(2)} S
      </div>
      <div style={{ position: "absolute", left: 80, right: 80, top: 320, fontSize: 100, fontWeight: 800 }}>{id}</div>
      <div style={{ position: "absolute", left: 80, right: 80, top: 470, fontSize: 52, fontWeight: 600, lineHeight: 1.15 }}>{what}</div>
      {devices ? <div style={{ position: "absolute", left: 80, right: 80, top: 900, fontSize: 38, fontWeight: 600, opacity: 0.75 }}>{devices}</div> : null}
    </AbsoluteFill>
  );
};

