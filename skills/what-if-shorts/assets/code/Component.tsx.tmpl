 * {{TITLE}} — a what-if-shorts film ({{ENGINE}} engine), flat kit (src/kit/flat).
 * Generated by ~/Developer/bb-plugins/skills/what-if-shorts/scripts/new_episode.py; edit freely from here on.
 * Shots switch on frame-snapped time (useTq): no blended cut frames in the 60 fps motion-blur master.
 */
import React from "react";
import { AbsoluteFill, Audio, staticFile } from "remotion";
import { useT, useTq } from "../../core/anim";
import { FlatCaptions } from "../../kit/flat/captions";
import { Grain, Vignette } from "../../kit/flat/look";
import { CHUNKS, DUR, HIDE, SHOTS, vo, type ShotId } from "./beats";
import { SHOTS_A } from "./shots";

export { DUR };
export type ShotProps = { t: number; t0: number; t1: number };
const REG: Partial<Record<ShotId, React.FC<ShotProps>>> = { ...SHOTS_A };
/** the Studio preview's audio: switch to "{{SLUG}}/mix.wav" once scripts/mix.py has run (render.sh muxes mix.wav itself) */
const AUDIO = "{{SLUG}}/vo/vo.wav";

export const {{COMP}}: React.FC<{ audio?: boolean }> = ({ audio = true }) => {
  const t = useT();
  const tq = useTq();
  const k = SHOTS.findIndex((s) => tq >= s.t0 && tq < s.t1);
  const shot = SHOTS[k < 0 ? SHOTS.length - 1 : k];
  const C = REG[shot.id];
  const end = shot.type === "end";
  const dark = shot.type === "slam" || shot.type === "threat";
  return (
    <AbsoluteFill style={{ background: "#0d0c0b", overflow: "hidden" }}>
      {C ? <C t={t} t0={shot.t0} t1={shot.t1} /> : null}
      {!end && <Grain o={0.08} />}
      {!end && <Vignette o={dark ? 0.6 : 0.4} />}
      <FlatCaptions vo={vo} chunks={CHUNKS} hide={HIDE} />
      {audio ? <Audio src={staticFile(AUDIO)} /> : null}
    </AbsoluteFill>
  );
};
