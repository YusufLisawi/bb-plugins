{
  "name": "bb-plugin-task-board",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Task Board",
    "description": "A calm kanban for your BB threads. Queue prompts on a thread, schedule them, chain them, and watch the agent work in the side panel.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  },
  "description": "A calm kanban for BB threads: queue, schedule, chain, and repeat agent tasks without leaving the board.",
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  }
}
